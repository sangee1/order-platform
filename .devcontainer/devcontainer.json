{
  "name": "order-platform",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [8080, 8081, 8082, 3000, 16686, 9090],
  "portsAttributes": {
    "8080": { "label": "order-service API" },
    "8081": { "label": "inventory-service API" },
    "8082": { "label": "payment-service API" },
    "3000": { "label": "Grafana dashboard", "onAutoForward": "openBrowser" },
    "16686": { "label": "Jaeger traces" },
    "9090": { "label": "Prometheus" }
  },
  "postCreateCommand": "docker compose pull || true",
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack"] }
  }
}
